# ── Bigbowl frontend (Vite) ────────────────────────────────────────────────
# Copy this file to ".env" and fill in your Supabase project values.
# Project URL and anon key: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── Bootstrap script only (scripts/bootstrap.mjs) ─────────────────────────
# NEVER expose the service role key in the frontend or commit it to git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: bootstrap script will create this back-office admin login
# ADMIN_EMAIL=admin@bigbowl.in
# ADMIN_PASSWORD=change-me-strong-password
